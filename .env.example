# Flask Settings
UNIVAULT_SECRET_KEY=your_development_secret_key_here
UNIVAULT_HTTPS=false
FLASK_DEBUG=1

# PostgreSQL Configuration (Leave empty to use local SQLite for development)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/univault

# Cloudflare R2 Configuration (Leave empty to use local filesystem for development)
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key
# R2_SECRET_ACCESS_KEY=your_secret_key
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev
